 import logging
import nmap
import time
import socket
import ipaddress
from collections import deque
from datetime import datetime, timezone
from dataclasses import dataclass, field
from flask import Flask, render_template, request
# Import packaging to safely handle semantic version comparisons
from packaging.version import Version, InvalidVersion

# Initialize Flask App
app = Flask(__name__)
logging.basicConfig(level=logging.ERROR, format='%(asctime)s - %(levelname)s - %(message)s')

scan_history = deque(maxlen=5)

# ---------------------------------------------------------------------------
# Dataclasses
# ---------------------------------------------------------------------------
@dataclass
class ScanRow:
    target: str
    port: int
    protocol: str
    service: str
    version: str  # e.g., "8.9p1" or "2.4.41"

@dataclass
class CVERecord:
    cve_id:      str
    cvss_score:  float
    severity:    str
    description: str

@dataclass
class ExploitRecord:
    cve_id:            str
    exploit_available: str
    risk_level:        str
    remediation:       str
    reference_url:     str
    created_at:        str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat())

@dataclass
class PatchStatus:
    is_vulnerable:   bool
    patch_available: bool
    fixed_version:   str
    status_message:  str

@dataclass
class EnrichedFinding:
    scan:          ScanRow
    cve:           CVERecord = None
    exploit:       ExploitRecord = None
    patch_status:  PatchStatus = None

# ---------------------------------------------------------------------------
# Dynamic Vulnerability & Patch Engine
# ---------------------------------------------------------------------------
# Format: "service_name": {"fixed_version": "X.Y.Z", "cve": ..., "exploit": ...}
VULN_DB = {
    "ssh": {
        "fixed_version": "9.8p1",
        "cve": CVERecord("CVE-2024-6387", 8.1, "High", "regreSSHion: Remote Code Execution vulnerability in OpenSSH server due to a race condition."),
        "exploit": ExploitRecord("CVE-2024-6387", "Yes (Public)", "Critical", "Upgrade OpenSSH to version 9.8p1 or higher.", "https://www.qualys.com/regresshion")
    },
    "http": {
        "fixed_version": "2.4.51",
        "cve": CVERecord("CVE-2021-41773", 7.5, "High", "Apache HTTP Server path traversal and file disclosure vulnerability."),
        "exploit": ExploitRecord("CVE-2021-41773", "Yes (Metasploit)", "High", "Update Apache HTTP Server to version 2.4.51 or higher.", "https://nvd.nist.gov/vuln/detail/CVE-2021-41773")
    },
    "https": {
        "fixed_version": "1.0.1g",
        "cve": CVERecord("CVE-2014-0160", 7.5, "High", "Heartbleed: OpenSSL memory leak vulnerability allowing key exposure."),
        "exploit": ExploitRecord("CVE-2014-0160", "Yes (Metasploit)", "High", "Patch OpenSSL to 1.0.1g or newer and revoke/reissue certificates.", "https://heartbleed.com/")
    }
}

def clean_version_string(version_str: str) -> str:
    """Helper to extract a clean semantic version from messy Nmap text."""
    # Split text and take the first item that looks like a version number
    parts = version_str.split()
    for part in parts:
        # Strip trailing sub-versions common in SSH (e.g., '8.6p1' -> '8.6')
        clean_part = part.split('p')[0].split('-')[0].strip()
        if any(char.isdigit() for char in clean_part):
            return clean_part
    return version_str

def analyze_patch_and_vuln(scan_row: ScanRow) -> tuple[CVERecord | None, ExploitRecord | None, PatchStatus]:
    service = scan_row.service.lower()
    raw_version = scan_row.version
    
    # Default status if service isn't tracked or version is missing
    if service not in VULN_DB or not raw_version or raw_version == "Unknown":
        return None, None, PatchStatus(
            is_vulnerable=False, 
            patch_available=False, 
            fixed_version="N/A", 
            status_message="No vulnerability data available or version unknown."
        )
    
    db_entry = VULN_DB[service]
    fixed_ver_str = db_entry["fixed_version"]
    detected_ver_str = clean_version_string(raw_version)
    
    try:
        # Attempt standard semantic version comparison
        if Version(detected_ver_str) < Version(clean_version_string(fixed_ver_str)):
            patch_status = PatchStatus(
                is_vulnerable=True,
                patch_available=True,
                fixed_version=fixed_ver_str,
                status_message=f"Vulnerable! A patch is available. Upgrade to v{fixed_ver_str}."
            )
            return db_entry["cve"], db_entry["exploit"], patch_status
        else:
            return None, None, PatchStatus(
                is_vulnerable=False,
                patch_available=False,
                fixed_version=fixed_ver_str,
                status_message="Up-to-date. No new patches required for this service identifier."
            )
    except InvalidVersion:
        # Fallback to string matching if parsing fails
        if detected_ver_str != fixed_ver_str:
            return db_entry["cve"], db_entry["exploit"], PatchStatus(
                is_vulnerable=True,
                patch_available=True,
                fixed_version=fixed_ver_str,
                status_message=f"Potential vulnerability detected. Dynamic version match failed, verification advised."
            )
        
    return None, None, PatchStatus(False, False, "N/A", "Service version clean.")

def resolve_and_validate_target(target_input):
    cleaned = target_input.strip()
    if not cleaned: raise ValueError("Target input cannot be empty.")
    try:
        ipaddress.ip_network(cleaned, strict=False)
        return cleaned
    except ValueError: pass
    try:
        return socket.gethostbyname(cleaned)
    except socket.gaierror:
        raise ValueError(f"Could not resolve or validate domain/IP range: '{target_input}'")

# ---------------------------------------------------------------------------
# Flask Routing
# ---------------------------------------------------------------------------
@app.route("/", methods=["GET", "POST"])
def index():
    enriched_findings = []
    messages = []
    last_target = ""
    scan_time = None
    elapsed = 0.0
    detected_os = "Unknown"

    if request.method == "POST":
        target_input = request.form.get("target", "").strip()
        last_target = target_input
        
        timing = request.form.get("timing", "4")
        custom_ports = request.form.get("ports", "").strip()
        udp_scan = "udp" in request.form
        os_detect = "os_detect" in request.form

        try:
            scan_target = resolve_and_validate_target(target_input)
            start_time = time.time()
            scan_time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

            # -sV activates Service Fingerprinting, -O activates OS Fingerprinting
            nmap_args = f"-sV -Pn -T{timing} " 
            
            if udp_scan:
                nmap_args += "-sU "
            if os_detect:
                nmap_args += "-O "
                
            if custom_ports:
                nmap_args += f"-p {custom_ports} "
            else:
                nmap_args += "-F " 

            scanner = nmap.PortScanner()
            scanner.scan(hosts=scan_target, arguments=nmap_args)

            for host in scanner.all_hosts():
                # Capture OS Fingerprint
                if os_detect and 'osmatch' in scanner[host] and len(scanner[host]['osmatch']) > 0:
                    detected_os = scanner[host]['osmatch'][0]['name']

                for proto in scanner[host].all_protocols():
                    ports = scanner[host][proto].keys()
                    for port in ports:
                        port_data = scanner[host][proto][port]
                        
                        if port_data['state'] == 'open':
                            # Extracting product and specific versions provided by Nmap fingerprinters
                            product = port_data.get('product', '')
                            version_num = port_data.get('version', '')
                            full_version = version_num if version_num else "Unknown"

                            scan_row = ScanRow(
                                target=host,
                                port=int(port),
                                protocol=proto.upper(),
                                service=port_data.get('name', 'unknown'),
                                version=full_version
                            )
                            
                            # Run through the Patch Analyzer
                            cve_record, exploit_record, patch_status = analyze_patch_and_vuln(scan_row)
                            
                            finding = EnrichedFinding(
                                scan=scan_row,
                                cve=cve_record,
                                exploit=exploit_record,
                                patch_status=patch_status
                            )
                            enriched_findings.append(finding)

            if not enriched_findings:
                messages.append(("info", f"Scan finished. No open services identified on {target_input}."))

            elapsed = round(time.time() - start_time, 2)
            scan_history.append({
                "target": target_input,
                "time": scan_time,
                "findings_count": len([f for f in enriched_findings if f.patch_status.is_vulnerable])
            })

        except ValueError as e:
            messages.append(("error", str(e)))
        except nmap.PortScannerError as e:
            logging.error(f"Nmap Error: {e}")
            messages.append(("error", f"Nmap engine failed: {e}. Note: OS Fingerprinting (-O) requires sudo root privileges."))
        except Exception as e:
            logging.exception("Unexpected dashboard error.")
            messages.append(("error", f"An unexpected system exception occurred: {type(e).__name__}"))

    return render_template(
        "index.html",
        findings=enriched_findings,
        messages=messages,
        history=reversed(scan_history),
        last_target=last_target,
        scan_time=scan_time,
        elapsed=elapsed,
        detected_os=detected_os
    )

if __name__ == "__main__":
    app.run(host="127.0.0.1", port=5000, debug=False)
