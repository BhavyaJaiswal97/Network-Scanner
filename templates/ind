<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Network Security Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f4f6f9;
        }

        .card {
            border: none;
            border-radius: 12px;
        }

        .table td,
        .table th {
            vertical-align: middle;
        }

        .risk-high {
            color: red;
            font-weight: bold;
        }

        .risk-safe {
            color: green;
            font-weight: bold;
        }
    </style>
</head>
<body>

<div class="container-fluid py-4">

    <div class="row">

        <!-- LEFT SIDEBAR -->
        <div class="col-xl-3 col-lg-4">

            <!-- SCAN FORM -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-danger text-white">
                    <strong>Network Scanner</strong>
                </div>

                <div class="card-body">

                    <form method="POST" action="/">

                        <div class="mb-3">
                            <label class="form-label">Target</label>

                            <input
                                type="text"
                                class="form-control"
                                name="target"
                                value="{{ last_target }}"
                                placeholder="IP, Hostname, CIDR"
                                required>
                        </div>

                        <div class="accordion" id="advancedOptions">

                            <div class="accordion-item">

                                <h2 class="accordion-header">
                                    <button
                                        class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#collapseOne">

                                        Scanner Parameters (Advanced)

                                    </button>
                                </h2>

                                <div
                                    id="collapseOne"
                                    class="accordion-collapse collapse">

                                    <div class="accordion-body">

                                        <div class="mb-3">
                                            <label class="form-label">
                                                Custom Ports
                                            </label>

                                            <input
                                                type="text"
                                                class="form-control"
                                                name="ports"
                                                placeholder="22,80,443 or 1-1000">
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">
                                                Timing Template
                                            </label>

                                            <select
                                                class="form-select"
                                                name="timing">

                                                <option value="3">
                                                    T3 - Normal
                                                </option>

                                                <option value="4" selected>
                                                    T4 - Aggressive
                                                </option>

                                                <option value="5">
                                                    T5 - Insane
                                                </option>

                                            </select>
                                        </div>

                                        <div class="form-check mb-2">

                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="os_detect"
                                                value="yes"
                                                id="os_detect">

                                            <label
                                                class="form-check-label"
                                                for="os_detect">

                                                Enable OS Detection

                                            </label>

                                        </div>

                                        <div class="form-check">

                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="udp"
                                                value="yes"
                                                id="udp">

                                            <label
                                                class="form-check-label text-danger"
                                                for="udp">

                                                Include UDP Scan

                                            </label>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <button
                            type="submit"
                            class="btn btn-danger w-100 mt-3">

                            Execute Scan

                        </button>

                    </form>

                </div>
            </div>

            <!-- HISTORY -->
            <div class="card shadow-sm">

                <div class="card-header bg-secondary text-white">
                    Recent Scans
                </div>

                <ul class="list-group list-group-flush">

                    {% if history %}

                        {% for item in history %}

                        <li class="list-group-item">

                            <strong>
                                {{ item.target }}
                            </strong>

                            <br>

                            <small class="text-muted">
                                {{ item.time }}
                            </small>

                            <span class="badge bg-danger float-end">
                                {{ item.findings_count }}
                            </span>

                        </li>

                        {% endfor %}

                    {% else %}

                        <li class="list-group-item text-center text-muted">
                            No Scan History
                        </li>

                    {% endif %}

                </ul>

            </div>

        </div>

        <!-- MAIN CONTENT -->
        <div class="col-xl-9 col-lg-8">

            {% for category, message in messages %}
            <div class="alert alert-{{ 'danger' if category == 'error' else 'info' }}">
                {{ message }}
            </div>
            {% endfor %}

            {% if detected_os and detected_os != "Unknown" %}

            <div class="alert alert-info">
                <strong>Detected OS:</strong>
                {{ detected_os }}
            </div>

            {% endif %}

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white d-flex justify-content-between">

                    <span>
                        Enriched Network Findings
                    </span>

                    {% if scan_time %}
                    <span class="badge bg-light text-dark">
                        Completed in {{ elapsed }} sec
                    </span>
                    {% endif %}

                </div>

                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover mb-0">

                            <thead class="table-dark">

                            <tr>
                                <th>Host</th>
                                <th>Port / Protocol</th>
                                <th>Service</th>
                                <th>CVE</th>
                                <th>CVSS</th>
                                <th>Remediation</th>
                            </tr>

                            </thead>

                            <tbody>

                            {% if findings %}

                                {% for finding in findings %}

                                <tr>

                                    <td>
                                        {{ finding.scan.target }}
                                    </td>

                                    <td>
                                        {{ finding.scan.port }}/{{ finding.scan.protocol }}
                                    </td>

                                    <td>
                                        <strong>
                                            {{ finding.scan.service }}
                                        </strong>

                                        <br>

                                        <small class="text-muted">
                                            {{ finding.scan.version }}
                                        </small>
                                    </td>

                                    <td>

                                        {% if finding.cve %}

                                            <span class="text-danger fw-bold">
                                                {{ finding.cve.cve_id }}
                                            </span>

                                            <br>

                                            <small>
                                                {{ finding.cve.description }}
                                            </small>

                                        {% else %}

                                            <span class="text-success">
                                                None
                                            </span>

                                        {% endif %}

                                    </td>

                                    <td>

                                        {% if finding.cve %}

                                            <span class="badge bg-danger">
                                                {{ finding.cve.cvss_score }}
                                            </span>

                                        {% else %}

                                            <span class="badge bg-success">
                                                Safe
                                            </span>

                                        {% endif %}

                                    </td>

                                    <td>

                                        {% if finding.patch_status %}

                                            {% if finding.patch_status.is_vulnerable %}

                                                <div class="risk-high">
                                                    ⚠ Patch Required
                                                </div>

                                                <small>
                                                    Fixed Version:
                                                    {{ finding.patch_status.fixed_version }}
                                                </small>

                                                <div>
                                                    {{ finding.patch_status.status_message }}
                                                </div>

                                            {% else %}

                                                <div class="risk-safe">
                                                    ✔ Up To Date
                                                </div>

                                                <div>
                                                    {{ finding.patch_status.status_message }}
                                                </div>

                                            {% endif %}

                                        {% endif %}

                                        {% if finding.exploit %}

                                            <hr>

                                            <small>
                                                Exploit:
                                                {{ finding.exploit.exploit_available }}
                                            </small>

                                            <br>

                                            <small>
                                                {{ finding.exploit.remediation }}
                                            </small>

                                            <br>

                                            {% if finding.exploit.reference_url %}

                                            <a
                                                href="{{ finding.exploit.reference_url }}"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="btn btn-sm btn-outline-primary mt-2">

                                                Threat Intel

                                            </a>

                                            {% endif %}

                                        {% endif %}

                                    </td>

                                </tr>

                                {% endfor %}

                            {% else %}

                                <tr>

                                    <td colspan="6" class="text-center py-5">
                                        Awaiting network audit parameters.
                                    </td>

                                </tr>

                            {% endif %}

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</ht
